{
  "name": "words-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-licenses.mjs && tsc -b && vite build && node scripts/compress-dictionary.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --pool=threads",
    "dictionary:build": "node scripts/build-dictionary.mjs",
    "cloudflare:dev": "wrangler d1 migrations apply words-personal --local && wrangler dev --ip 127.0.0.1 --port 8787",
    "cloudflare:deploy": "npm run typecheck && npm test && npm run build && node scripts/check-budgets.mjs && wrangler d1 migrations apply words-personal --remote && wrangler deploy",
    "cloudflare:setup": "node scripts/setup-cloudflare.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "csv-parse": "^7.0.3",
    "fake-indexeddb": "^6.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
