{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "words-notebook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "words-personal",
      "migrations_dir": "worker/migrations",
      "database_id": "6c0737a8-ffc5-46ad-979f-86d073f7692c"
    }
  ],
  "vars": {
    "ALLOWED_GITHUB_ID": "266625893"
  },
  "observability": {
    "enabled": false
  }
}
