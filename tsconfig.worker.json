{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "verbatimModuleSyntax": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["worker", "shared", "src/types"]
}
